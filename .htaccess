# .htaccess — هدایت همه‌ی درخواست‌ها به index.php (مسیریاب متمرکز)
<IfModule mod_rewrite.c>
RewriteEngine On

# فایل‌های واقعی (CSS/JS/تصویر) مستقیم سرو شوند
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# بقیه به index.php
RewriteRule ^ index.php [L]
</IfModule>

# محافظت از داده‌ها و فایل‌های حساس
<FilesMatch "^(\.|welfvita_|wv_)">
Require all denied
</FilesMatch>
<IfModule mod_authz_core.c>
  <Files "php-panel/data/~">
    Require all denied
  </Files>
</IfModule>

Options -Indexes
